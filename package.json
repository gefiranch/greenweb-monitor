{
  "name": "greenweb-monitor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env src/server.js",
    "test": "node --test tests/*.test.js",
    "test:live": "node --env-file-if-exists=.env scripts/live-check.mjs",
    "evaluate": "node --env-file-if-exists=.env scripts/evaluate.mjs",
    "build": "node scripts/build.mjs",
    "validate": "node scripts/validate-artifact.mjs"
  },
  "dependencies": { "@tgwf/co2": "0.19.0", "express": "5.1.0", "ipaddr.js": "2.2.0" },
  "devDependencies": { "esbuild": "0.25.12" }
}
